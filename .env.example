# Settings for the local stack. `make up` copies this to .env with random passwords.
# .env is git-ignored. Real secrets live in Kubernetes Secrets from Phase 5.

# Postgres admin user: for you and the init script only; services never use it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Password for every service role (<service>_owner and <service>_app), local dev only.
SERVICE_DB_PASSWORD=change-me

# Host ports. All are bound to 127.0.0.1, so they are reachable only from this laptop.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=19092
SCHEMA_REGISTRY_PORT=18081

# Observability (make obs-up). compose.yaml has the same defaults, so an older .env still works.
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
